---
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
import '../styles/magazine.css';
import Assistant from '../components/buyer/Assistant.astro';
import SEO from '../components/common/SEO.astro';
import Analytics from '../components/common/Analytics.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import JourneyAnalytics from '../components/buyer/JourneyAnalytics.astro';
import { features, nav, site } from '../config';
import { t } from '../i18n';
import { getBuyerBrief } from '../lib/buyer-brief';

// `nameplate` prints the wordmark in the sticky bar. The home page sets it false: there the
// wordmark is the cover, set across the photograph, and a second small one above it reads as
// a repeat rather than a masthead.
type Props = ComponentProps<typeof SEO> & { nameplate?: boolean };
const { nameplate = true, ...seoProps } = Astro.props;
const locale = Astro.currentLocale ?? site.locale;
const ui = t(locale);
const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pageBrief = getBuyerBrief(path);
const enquiryHref = pageBrief ? '/enquiry?from=' + encodeURIComponent(pageBrief.page_path) : '/enquiry';
const themeCredit = 'https://ondelva.com/themes/halftone';
---

<html lang={locale} data-editorial-style={site.designDirection}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* The faces from the fonts block in astro.config.mjs. Preload only what is above the fold
        on the cover: Spectral 400 for decks and body, Schibsted Grotesk 400 for the navigation
        and 800 for the headlines. The 900 wordmark and the mono kickers swap in a frame later,
        which costs nothing here because both sit on the plate at a fixed size. */}
    <Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
    <Font
      cssVariable="--font-heading"
      preload={[
        { weight: '400', style: 'normal' },
        { weight: '800', style: 'normal' },
      ]}
    />
    <Font cssVariable="--font-mono" />
    <SEO {...seoProps} />
    <Analytics />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      {ui.skip}
    </a>

    {site.privatePreview && <p class="preview-bar" data-pagefind-ignore>
      <span>{ui.magazine.privatePreview}</span> <a href="/colophon">{ui.magazine.sourcesAndScope}</a>
    </p>}

    {/* One bar. Desktop: wordmark, desks, actions on a single line. Narrow: wordmark and the two
        buyer actions on the first line, the desks on a second line that scrolls sideways rather
        than wrapping into a block that pushes the cover off the first screen. */}
    <header class="bar">
      <div class="bar-inner">
        <a class:list={['bar-wordmark', !nameplate && 'bar-wordmark--quiet']} href="/" aria-label={nameplate ? undefined : site.name + ' — home'}>{site.name}</a>
        <nav aria-label={ui.desks} class="bar-desks">
          {nav.header.map((item) => (
            <a href={item.href} aria-current={path === item.href || path.startsWith(item.href + '/') ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="/search" aria-current={path === '/search' ? 'page' : undefined}>{ui.magazine.search}</a>
        </nav>
        <div class="bar-actions">
          <button class="bar-action" type="button" data-assistant-open aria-label={ui.askSourcing}>
            <span class="header-label-full">{ui.askSourcing}</span><span class="header-label-short" aria-hidden="true">{ui.magazine.askShort}</span>
          </button>
          <a class="bar-action bar-action--primary" href={enquiryHref} aria-label={ui.prepareEnquiry}>
            <span class="header-label-full">{ui.prepareEnquiry}</span><span class="header-label-short" aria-hidden="true">{ui.enquiryNav}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
      <Assistant />
    </main>

    <footer class="border-foreground mt-16 border-t-[3px] sm:mt-24">
      <div class="max-w-wide mx-auto flex flex-wrap justify-between gap-x-12 gap-y-8 px-4 py-10 sm:py-14">
        <div class="max-w-[30ch]">
          <p class="font-ui text-primary text-3xl leading-none font-black tracking-[-0.035em]">
            {site.name}
          </p>
          <p class="text-muted mt-3 text-sm">{site.description}</p>
        </div>
        {nav.footer.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="font-mono text-xs font-semibold uppercase">{group.title}</h2>
            <ul class="font-ui text-muted mt-3 space-y-2 text-sm">
              {group.links.map((link) => (
                <li>
                  <a class="hover:text-primary no-underline" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        {features.darkMode && (
          <div class="footer-theme">
            <p class="font-mono text-xs font-semibold uppercase">{ui.magazine.theme}</p>
            <div class="mt-3"><ThemeToggle /></div>
          </div>
        )}
        {nav.social.length > 0 && (
          <ul class="flex items-start gap-4">
            {nav.social.map((link) => (
              <li>
                <a class="hover:text-primary block" href={link.href} aria-label={link.label}>
                  <Icon name={link.icon} class="size-5" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {/* The one line crediting the theme. Deleting it is a line of work and no licence
          trouble; leaving it is how the next person finds the theme. */}
      <p class="max-w-wide text-muted mx-auto px-4 pb-10 font-mono text-[0.6875rem]">
        &copy; {year} {site.name}. Edited by {site.author}.{' '}
        <a class="hover:text-foreground" href={themeCredit} rel="nofollow">
          Halftone
        </a>{' '}
        theme by ondelva.
      </p>
    </footer>
    <JourneyAnalytics />
  </body>
</html>
