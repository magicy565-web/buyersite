---
import { site } from '../../config';
import { loadBuyerBriefs } from '../../lib/buyer-brief';
import { buyerNavigationPaths } from '../../lib/buyer-journey.mjs';
const briefs = site.analyticsEnabled ? loadBuyerBriefs() : [];
---
{site.analyticsEnabled && <span id="journey-config" data-site={site.slug} data-paths={JSON.stringify(buyerNavigationPaths(briefs))} data-articles={JSON.stringify(briefs.map((brief) => brief.page_path))} hidden></span>}
<script>
  import { captureJourney, clearJourney, privacyOptOut, readJourney } from '../../lib/buyer-journey.mjs';
  const config=document.querySelector<HTMLElement>('#journey-config');
  const storage=()=>{try{return window.sessionStorage;}catch{return null;}};
  const optedOut=()=>privacyOptOut(navigator);
  if(config){
    captureJourney(storage(),{siteSlug:config.dataset.site!,allowedPaths:JSON.parse(config.dataset.paths!),articlePaths:JSON.parse(config.dataset.articles!),path:location.pathname,search:location.search,optedOut:optedOut()});
  }
  const names=new Set(['page_view','article_opened','enquiry_started','enquiry_submitted','assistant_opened','search_used','source_opened']);
  function track(name:string){
    if(!config)return;
    if(optedOut()){clearJourney(storage(),config.dataset.site!);return;}
    if(!names.has(name))return;
    const path=location.pathname;
    // No free text, search terms, email, IP, user ID or full referrer is sent.
    const saved=readJourney(storage(),config.dataset.site!,JSON.parse(config.dataset.paths!),JSON.parse(config.dataset.articles!),false);
    const event={eventId:crypto.randomUUID(),name,path,...(saved?.campaign?.campaign?{campaign:saved.campaign,landingPath:saved.landing_path}:{})};
    void fetch('/api/events',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(event),keepalive:true}).catch(()=>{});
    const umami=(window as Window & {umami?:{track:(name:string,props:Record<string,string>)=>void}}).umami;
    umami?.track(name,{path});
  }
  track('page_view');
  if(/^\/(materials|products|suppliers|guides)\/[^/]+\/?$/.test(location.pathname))track('article_opened');
  window.addEventListener('buyersite:event',(e)=>{const name=(e as CustomEvent).detail?.name;if(typeof name==='string')track(name);});
  document.addEventListener('click',(e)=>{const a=(e.target as Element)?.closest('a');if(a&&new URL(a.href,location.origin).origin!==location.origin&&a.closest('#source-evidence'))track('source_opened');});
</script>
