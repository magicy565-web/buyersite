---
import type { EvidenceItem } from '../../lib/evidence';
import { buyerEnquiryHref, type BuyerBrief } from '../../lib/buyer-brief';
import { site } from '../../config';
import { t } from '../../i18n';
import '../../styles/editorial.css';
interface Props { items: EvidenceItem[]; brief?: BuyerBrief | null; }
const { items, brief } = Astro.props;
const ui = t(Astro.currentLocale ?? site.locale);
---
<section id="buyer-summary" aria-labelledby="buyer-summary-title" class="buyer-summary">
  <h2 id="buyer-summary-title">{ui.editorial.briefSummary}</h2>
  {brief && <p class="buyer-summary-intro">{brief.summary}</p>}
  <div class="buyer-summary-columns">
    <section aria-labelledby="known-details-title">
      <h3 id="known-details-title">{ui.editorial.knownHeading}</h3>
      {items.length > 0 ? (
        <dl class="buyer-known-facts">
          {items.map((item) => (
            <div data-evidence-id={item.evidence_id}>
              <dt>{item.claim}</dt>
              <dd>{item.value}</dd>
              <dd class="buyer-fact-source"><a href={'#source-' + item.evidence_id}>{item.source_url ? ui.editorial.supplierStatement : ui.editorial.enterpriseRecord}</a></dd>
            </div>
          ))}
        </dl>
      ) : <p class="editorial-source-note">{ui.editorial.noEvidence}</p>}
    </section>
    {brief && brief.unconfirmed.length > 0 && (
      <section aria-labelledby="open-details-title">
        <h3 id="open-details-title">{ui.editorial.openHeading}</h3>
        <dl class="buyer-open-facts">
          {brief.unconfirmed.map((item) => (
            <div><dt>{item.label}</dt><dd>{item.detail}</dd></div>
          ))}
        </dl>
      </section>
    )}
  </div>
  <div class="buyer-summary-actions">
    <a class="buyer-action editorial-enquiry-link" href={buyerEnquiryHref(brief)} data-buyer-context={brief?.page_path}>{ui.prepareEnquiry}</a>
    <a class="editorial-text-link" href="#buyer-questions">{ui.editorial.jumpQuestions}</a>
  </div>
</section>
