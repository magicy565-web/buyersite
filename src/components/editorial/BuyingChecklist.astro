---
import type { Item } from '../../lib/content';
import { buyerEnquiryHref, type BuyerBrief } from '../../lib/buyer-brief';
import { site } from '../../config';
import { t } from '../../i18n';
import '../../styles/editorial.css';

interface Props { guide?: Item; brief?: BuyerBrief | null; compact?: boolean; id?: string; }
const { guide, brief, compact = false, id = 'buying-checklist' } = Astro.props;
const ui = t(Astro.currentLocale ?? site.locale);
const questions = brief?.questions ?? [
  { id: 'use', label: ui.editorial.checkUseTitle, prompt: ui.editorial.checkUseDetail },
  { id: 'quantity', label: ui.editorial.checkQuantityTitle, prompt: ui.editorial.checkQuantityDetail },
  { id: 'evidence', label: ui.editorial.checkEvidenceTitle, prompt: ui.editorial.checkEvidenceDetail },
  { id: 'terms', label: ui.editorial.checkTermsTitle, prompt: ui.editorial.checkTermsDetail },
];
const enquiryHref = brief ? buyerEnquiryHref(brief) : guide ? '/enquiry?from=' + encodeURIComponent(guide.href) : '/enquiry';
---

<section id={id} class:list={['buying-checklist', 'editorial-section', compact && 'buying-checklist-compact']}
  data-editorial-block="checklist" aria-labelledby={id + '-title'}>
  <div class="buying-checklist-intro">
    <p class="editorial-section-label">{ui.editorial.buyingGuide}</p>
    <h2 id={id + '-title'}>{compact ? ui.editorial.questionsHeading : guide?.data.title ?? ui.editorial.checklistTitle}</h2>
    <p class="editorial-deck">{brief ? ui.editorial.questionsIntro : guide?.data.deck ?? ui.editorial.checklistIntro}</p>
    {guide && <a class="editorial-text-link" href={guide.href}>{ui.editorial.readBuyingGuide}</a>}
  </div>
  <div class="buying-checklist-questions">
    <ol>
      {questions.map((question) => (
        <li data-buyer-question={question.id}>
          <h3>{question.label}</h3>
          <p>{question.prompt}</p>
          {brief && <a href={buyerEnquiryHref(brief, question.id)} data-buyer-context={brief.page_path}>{ui.editorial.useQuestion}</a>}
        </li>
      ))}
    </ol>
    <a class="buyer-action editorial-enquiry-link" href={enquiryHref} data-buyer-context={brief?.page_path ?? guide?.href}>{ui.prepareEnquiry}</a>
  </div>
</section>
