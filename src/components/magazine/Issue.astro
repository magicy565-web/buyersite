---
import Spread from './Spread.astro';
import '../../styles/magazine-issue.css';
import { assertMagazineIssue } from '../../magazine/issue-contract.mjs';
interface Props { issue: any; }
const {issue}=Astro.props;
assertMagazineIssue(issue);
const assets=Object.fromEntries(issue.assets.map((asset:any)=>[asset.id,asset]));
const evidence=Object.fromEntries((issue.evidence||[]).map((item:any)=>[item.id,item]));
const isConcept=issue.publicationStatus==='concept-private';
const navItems=issue.spreads.filter((spread:any)=>!['cover','contents'].includes(spread.kind));
---
<div class="mi-root" data-publication-status={issue.publicationStatus}>
  <p class="mi-prototype-banner">{isConcept
    ? 'PRIVATE DESIGN PROTOTYPE · Concept artwork only · No verified supplier claims'
    : 'PRIVATE EDITION PREVIEW · Source-bound draft · Not approved for publication'}</p>
  <nav class="mi-nav" aria-label="Magazine navigation">
    <a class="mi-brand" href="#cover">{issue.brand}</a>
    <div>
      <a href="#contents">Contents</a>
      {navItems.slice(0,4).map((spread:any)=><a href={'#'+spread.id}>{spread.title}</a>)}
    </div>
    <a class="mi-sourcing-link" href="#sourcing">Sourcing ↗</a>
  </nav>
  <main id="main" class="mi-main">
    {issue.spreads.map((spread:any)=><Spread spread={spread} assets={assets} evidence={evidence}
      brand={issue.brand} publicationStatus={issue.publicationStatus}/>)}
  </main>
  <footer class="mi-footer">
    <b>{issue.brand}</b>
    <span>{isConcept
      ? 'Private editorial concept. No product, manufacturing or commercial claims are verified.'
      : 'Private source-bound preview. Image rights, editorial review and publication approval remain separate gates.'}</span>
    <a href="#cover">Back to cover ↑</a>
  </footer>
</div>
<script>
  document.querySelector('#mi-prepare')?.addEventListener('click',()=>{
    const input=document.querySelector('#mi-brief');
    const output=document.querySelector('#mi-result');
    if(!(input instanceof HTMLTextAreaElement)||!(output instanceof HTMLOutputElement)||!input.value.trim())return;
    output.textContent='LOCAL DRAFT — NOT SUBMITTED\n'+input.value.trim()+'\n\nQuestions to confirm: product details, quantity, target market, MOQ, price, lead time and logistics.';
    output.hidden=false;
  });
</script>