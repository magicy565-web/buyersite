---
import Media from './Media.astro';
interface Props {
  spread: any;
  assets: Record<string,any>;
  evidence: Record<string,any>;
  sourceArticles: any[];
  brand: string;
  publicationStatus: string;
}
const {spread,assets,evidence,sourceArticles,brand,publicationStatus}=Astro.props;
const articlePath=(id:string)=>sourceArticles.find((article:any)=>article.id===id)?.path||'';
const media=(spread.assetIds||[]).map((id:string)=>assets[id]).filter(Boolean);
const cited=(spread.evidenceRefs||[]).map((id:string)=>evidence[id]).filter(Boolean);
const galleryItems=new Map((spread.items||[]).map((item:any)=>[item.articleId,item]));
---
<section id={spread.id} class:list={['mi-spread','mi-'+spread.kind,
  spread.kind==='contents' && media.length===0 && 'mi-contents-text-only',
  spread.kind==='story' && media.length===0 && 'mi-story-text-only']} data-layout={spread.kind}>
  {spread.kind==='cover' && <>
    <div class="mi-cover-copy"><p class="mi-kicker">{spread.kicker}</p><strong class="mi-brand-large">{brand}</strong><h1>{spread.title}</h1><p class="mi-deck">{spread.deck}</p><a class="mi-link" href="#contents">Open the issue ↗</a></div>
    <Media asset={media[0]} className="mi-cover-image" />
  </>}
  {spread.kind==='contents' && <>
    <div class="mi-head"><p class="mi-kicker">{spread.kicker}</p><h2>{spread.title}</h2><p class="mi-deck">{spread.deck}</p></div>
    {media[0] && <Media asset={media[0]} className="mi-tall"/>}
    <nav class="mi-toc" aria-label="Issue contents">{spread.chapters.map((chapter:any)=><a href={'#'+chapter.target}><span>{chapter.number}</span>{chapter.title}<span>↗</span></a>)}</nav>
  </>}
  {spread.kind==='story' && <>
    <div class="mi-head"><p class="mi-kicker">{spread.kicker}</p><h2>{spread.title}</h2><p class="mi-deck">{spread.deck}</p>
      <div class="mi-prose">
        {spread.sections?.map((section:any)=><section><h3>{section.heading}</h3><p>{section.body}</p></section>)}
        {spread.paragraphs?.map((paragraph:string)=><p>{paragraph}</p>)}
      </div>
    </div>
    {media[0] && <Media asset={media[0]} className="mi-tall"/>}
  </>}
  {spread.kind==='craft' && <>
    <div class="mi-head"><p class="mi-kicker">{spread.kicker}</p><h2>{spread.title}</h2><p class="mi-deck">{spread.deck}</p><div class="mi-prose">{spread.paragraphs?.map((paragraph:string)=><p>{paragraph}</p>)}</div></div>
    <div class="mi-craft-images">{media.map((asset:any)=><Media asset={asset}/>)}</div>
  </>}
  {spread.kind==='gallery' && <>
    <div class="mi-head"><p class="mi-kicker">{spread.kicker}</p><h2>{spread.title}</h2><p class="mi-deck">{spread.deck}</p></div>
    <div class="mi-gallery-images">{media.map((asset:any)=><div class="mi-gallery-item">
      <Media asset={asset}/>
      {galleryItems.get(asset.articleId) && <div class="mi-gallery-copy"><h3><a href={articlePath(asset.articleId)}>{galleryItems.get(asset.articleId).title}</a></h3><p>{galleryItems.get(asset.articleId).deck}</p><a href={articlePath(asset.articleId)} class="mi-article-link">Read the story ↗</a></div>}
    </div>)}</div>
  </>}
  {spread.kind==='notes' && <>
    <div class="mi-head"><p class="mi-kicker">{spread.kicker}</p><h2>{spread.title}</h2><p class="mi-deck">{spread.deck}</p>{media[0] && <Media asset={media[0]}/>}</div>
    <div class="mi-note-ledger">
      {cited.length>0 && <><p class="mi-kicker">SOURCE NOTES / RECORDED EVIDENCE</p>{cited.map((item:any,i:number)=><article class="mi-evidence-item">
        <span>{String(i+1).padStart(2,'0')}</span><div><h3>{item.claim}</h3><p>{item.value}</p>
          <small>{item.status} · {item.permission}</small>
          {item.sourceUrl && <a href={item.sourceUrl} rel="nofollow noopener" target="_blank">Open original source ↗</a>}
        </div>
      </article>)}</>}
      {spread.questions?.length>0 && <><p class="mi-kicker">QUESTIONS / TO VERIFY</p>{spread.questions.map((item:any,i:number)=><article><span>{String(i+1).padStart(2,'0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div><small>TO VERIFY</small></article>)}</>}
    </div>
  </>}
  {spread.kind==='sourcing' && <>
    <div class="mi-head"><p class="mi-kicker">{spread.kicker}</p><h2>{spread.title}</h2><p class="mi-deck">{spread.deck}</p>
      <label for="mi-brief">What would you like to source?</label>
      <textarea id="mi-brief" rows="4" maxlength="500" placeholder="Describe your product idea or sourcing question"></textarea>
      <button id="mi-prepare" type="button">Prepare a local brief ↗</button><output id="mi-result" hidden></output>
      <button class="mi-open-assistant" type="button" data-assistant-open data-source-article={articlePath(spread.articleId)}>Ask about this edition ↗</button>
      <p class="mi-disclaimer">The sourcing assistant uses this edition\u0027s approved article context. Preparing a brief does not submit an enquiry.</p>
    </div>
    <Media asset={media[0]} className="mi-tall"/>
  </>}
  {spread.kind!=='cover' && <div class="mi-folio"><span>{brand} / {publicationStatus==='concept-private'?'CONCEPT ISSUE':'PRIVATE EDITION'}</span><span>{spread.folio}</span></div>}
</section>