---
// "In this edition": the contents page. Numbered rows, the reading path a buyer chooses first,
// each with one line on what that path answers. Not cards: a contents list reads down.
import type { Item } from '../../lib/content';
import { site } from '../../config';
import { t } from '../../i18n';
import '../../styles/magazine.css';

interface Entry { item: Item; label: string; note: string }
interface Props { entries: Entry[]; title?: string }
const { entries, title } = Astro.props;
const ui = t(Astro.currentLocale ?? site.locale);
---

{entries.length > 0 && (
  <nav class="mag-container edition-index" aria-labelledby="edition-index-title" data-editorial-block="index">
    <h2 id="edition-index-title" class="mag-section-label">{title ?? ui.magazine.inThisEdition}</h2>
    <ol>
      {entries.map((entry, index) => (
        <li>
          <a href={entry.item.href}>
            <span class="edition-index-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="edition-index-path">{entry.label}</span>
            <span class="edition-index-title">{entry.item.data.title}</span>
            <span class="edition-index-note">{entry.note}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
