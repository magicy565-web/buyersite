{
  "name": "buyer-magazine-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Independent evidence-led buyer magazine pilot",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare:media": "node scripts/prepare-media.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "prebuild": "pnpm prepare:media && pnpm validate:content",
    "verify:output": "node scripts/verify-output.mjs",
    "test:browser": "playwright test",
    "site:from-enterprise": "node site-builder/from-enterprise.mjs",
    "site:from-snapshots": "node site-builder/build.mjs",
    "test:site-builder": "node --test site-builder/*.test.mjs",
    "accept:site-builder": "node site-builder/acceptance.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "4.0.19",
