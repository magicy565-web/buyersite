{
  "name": "buyer-magazine-site",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Independent evidence-led buyer magazine pilot",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "astro build && node scripts/finalize-site.mjs",
    "preview": "node scripts/dev-server.mjs",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:editorial": "node scripts/check-editorial-profiles.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare:media": "node scripts/prepare-media.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "prebuild": "pnpm prepare:media && pnpm validate:content && pnpm check:editorial",
    "verify:output": "node scripts/verify-output.mjs",
    "test:browser": "playwright test",
    "site:from-enterprise": "node site-builder/from-enterprise.mjs",
    "site:from-snapshots": "node site-builder/build.mjs",
    "site:worker": "node site-builder/worker.mjs",
    "test:site-builder": "node --test site-builder/*.test.mjs",
    "accept:site-worker": "node site-builder/worker-acceptance.mjs",
    "accept:site-builder": "node site-builder/acceptance.mjs",
    "dev:astro": "astro dev",
    "test:runtime": "node --test runtime/*.test.mjs",
    "test:knowledge": "node --test scripts/public-knowledge.test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "collection:run": "node collection/cli.mjs",
    "test:collection": "node --test collection/*.test.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.36",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@iconify-json/lucide": "1.2.132",
    "@tailwindcss/vite": "4.3.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.3",
    "astro-icon": "1.2.0",
    "esbuild": "0.28.2",
    "pagefind": "1.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "pnpm@11.25.0"
}
